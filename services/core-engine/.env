# Kişisel Öğrenme Motoru (Personal Learning Engine) - Üretim Ortam Yapılandırması
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=ple_production_secret_key_2026_cognitive_kernel_defense
HOST=127.0.0.1
PORT=8000

# Veritabanı ve Önbellek Yapılandırması (PostgreSQL 15 & Redis 7.2)
DATABASE_URL=postgresql://ple_user:ple_secure_pass_2026@127.0.0.1:5432/ple_db
REDIS_URL=redis://127.0.0.1:6379/0

# Sıkılaştırılmış CORS İzinleri (Wildcard kaldırılmıştır)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8000,http://10.0.2.2:8000,app://ple.local

# Güvenlik ve Hız Sınırları
WS_RATE_LIMIT=2
CAS_TIMEOUT_MS=500
MAX_AST_DEPTH=15
LOG_LEVEL=INFO
